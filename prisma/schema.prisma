// RNS Gestão Contábil — schema principal do banco de dados
// Multiempresa (organization_id) preparado para uso futuro em modo SaaS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ORGANIZAÇÃO / MULTIEMPRESA
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  primaryColor String? @default("#0f172a")
  timezone  String   @default("America/Sao_Paulo")
  locale    String   @default("pt-BR")
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  roles              Role[]
  departments        Department[]
  clients            Client[]
  serviceCatalogItems ServiceCatalogItem[]
  checklistTemplates ChecklistTemplate[]
  clientServices     ClientService[]
  tasks              Task[]
  contracts          Contract[]
  contractTemplates  ContractTemplate[]
  receivables        Receivable[]
  documents          Document[]
  notifications      Notification[]
  automationRules    AutomationRule[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// USUÁRIOS, PERFIS E PERMISSÕES (RBAC)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String   // ex: ADMIN, GESTOR, COLABORADOR, FINANCEIRO ou chave customizada
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  permissions    String[] // lista de chaves de permissão, ex: ["clients.view", "financeiro.manage"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]

  @@unique([organizationId, key])
  @@map("roles")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String
  avatarUrl      String?
  phone          String?
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  departments        UserDepartment[]
  createdTasks       Task[]              @relation("TaskCreator")
  assignedTasks       Task[]              @relation("TaskAssignee")
  taskComments       TaskComment[]
  attachmentsUploaded TaskAttachment[]
  documentsUploaded  Document[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  clientsResponsible Client[]            @relation("ClientResponsible")
  timeEntries        TaskTimeEntry[]
  delayReasons       TaskDelayLog[]      @relation("DelayReportedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String?  @default("#6366f1")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           UserDepartment[]
  serviceCatalogItems ServiceCatalogItem[]
  clientServices  ClientService[]
  tasks           Task[]

  @@unique([organizationId, name])
  @@map("departments")
}

model UserDepartment {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_departments")
}

// ---------------------------------------------------------------------------
// CLIENTES E SÓCIOS
// ---------------------------------------------------------------------------

enum ClientStatus {
  LEAD
  IMPLANTACAO
  ATIVO
  SUSPENSO
  INATIVO
  ENCERRADO
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  IMUNE
  ISENTO
  OUTROS
}

model Client {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String   // código interno
  legalName         String   // razão social
  tradeName         String?  // nome fantasia
  cnpj              String?
  cpf               String?
  stateRegistration String?
  municipalRegistration String?
  mainCnae          String?
  secondaryCnaes    String[]
  taxRegime         TaxRegime @default(SIMPLES_NACIONAL)
  foundationDate    DateTime?
  onboardingDate    DateTime?
  responsibleUserId String?
  responsibleUser   User?    @relation("ClientResponsible", fields: [responsibleUserId], references: [id])
  phone             String?
  whatsapp          String?
  email             String?
  zipCode           String?
  address           String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  city              String?
  state             String?
  notes             String?
  status            ClientStatus @default(LEAD)
  monthlyFee        Decimal? @db.Decimal(12, 2)
  feeDueDay         Int?
  onboardingChecklist Json?  // etapas do onboarding e percentual concluído
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  archived          Boolean  @default(false)

  partners        Partner[]
  services        ClientService[]
  tasks           Task[]
  contracts       Contract[]
  receivables     Receivable[]
  documents       Document[]
  auditLogs       AuditLog[]
  documentRequests DocumentRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("clients")
}

model Partner {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  cpf          String?
  equityShare  Decimal? @db.Decimal(5, 2) // participação societária %
  role         String?  // cargo
  phone        String?
  email        String?
  entryDate    DateTime?
  exitDate     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("partners")
}

// ---------------------------------------------------------------------------
// CATÁLOGO DE SERVIÇOS E TEMPLATES DE CHECKLIST
// ---------------------------------------------------------------------------

enum Periodicity {
  UNICA
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  PERSONALIZADA
}

model ServiceCatalogItem {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  name                String
  category            String?
  description         String?
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  defaultResponsibleId String?
  defaultValue        Decimal? @db.Decimal(12, 2)
  periodicity         Periodicity @default(MENSAL)
  defaultDeadlineDay  Int?      // dia padrão de prazo oficial
  internalDeadlineDay Int?      // dia padrão de prazo interno
  slaDays             Int?      // SLA em dias úteis
  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  requiredDocuments   String[]
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clientServices ClientService[]

  @@unique([organizationId, code])
  @@map("service_catalog_items")
}

model ChecklistTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          ChecklistTemplateItem[]
  serviceCatalogItems ServiceCatalogItem[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id                  String   @id @default(cuid())
  checklistTemplateId String
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  order               Int
  description         String
  required            Boolean  @default(true)
  requiresDocument    Boolean  @default(false)
  dependsOnItemId     String?
  notes               String?

  @@map("checklist_template_items")
}

// ---------------------------------------------------------------------------
// SERVIÇOS POR CLIENTE
// ---------------------------------------------------------------------------

model ClientService {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceCatalogItemId String
  serviceCatalogItem  ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id])
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  responsibleId       String?
  startDate           DateTime @default(now())
  periodicity         Periodicity @default(MENSAL)
  value               Decimal? @db.Decimal(12, 2)
  dueDay              Int?     // dia do vencimento oficial
  internalDeadlineDay Int?     // prazo operacional interno
  billingType         String?  // forma de cobrança
  notes               String?
  active              Boolean  @default(true)
  // personalização de checklist específica do cliente (itens extras sobre o template)
  extraChecklistItems Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tasks Task[]

  @@index([organizationId, clientId])
  @@map("client_services")
}

// ---------------------------------------------------------------------------
// TAREFAS
// ---------------------------------------------------------------------------

enum TaskStatus {
  NAO_INICIADA
  AGUARDANDO_DOCUMENTOS
  EM_ANDAMENTO
  EM_REVISAO
  AGUARDANDO_CLIENTE
  CONCLUIDA
  CANCELADA
  ATRASADA
}

enum TaskPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

model Task {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  title           String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  clientServiceId String?
  clientService   ClientService? @relation(fields: [clientServiceId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  assigneeId      String?
  assignee        User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId       String?
  creator         User?    @relation("TaskCreator", fields: [creatorId], references: [id])
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(NAO_INICIADA)
  competence      String?  // MM/YYYY
  internalDueDate DateTime?
  officialDueDate DateTime?
  startDate       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  productionStage String?  // etapa da linha de produção (documentos, escrituração, conferência, apuração, revisão, guia emitida, envio, concluído)
  recurrenceRule  Json?    // regra de recorrência (frequency, interval, until)
  parentRecurringTaskId String? // referência à tarefa "mestre" que originou a série
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  checklistItems  TaskChecklistItem[]
  subtasks        Task[]   @relation("TaskParent")
  parentTaskId    String?
  parentTask      Task?    @relation("TaskParent", fields: [parentTaskId], references: [id])
  comments        TaskComment[]
  attachments     TaskAttachment[]
  dependsOn       TaskDependency[] @relation("DependentTask")
  dependents      TaskDependency[] @relation("PrerequisiteTask")
  timeEntries     TaskTimeEntry[]
  delayLogs       TaskDelayLog[]
  receivables     Receivable[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, officialDueDate])
  @@map("tasks")
}

model TaskChecklistItem {
  id               String   @id @default(cuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order            Int
  description      String
  required         Boolean  @default(true)
  requiresDocument Boolean  @default(false)
  dependsOnItemId  String?
  notes            String?
  completed        Boolean  @default(false)
  completedAt      DateTime?
  completedBy      String?

  @@map("task_checklist_items")
}

model TaskDependency {
  id                  String @id @default(cuid())
  dependentTaskId     String
  dependentTask       Task   @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  prerequisiteTaskId  String
  prerequisiteTask    Task   @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, prerequisiteTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  mentions  String[]
  createdAt DateTime @default(now())

  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedById String?
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())

  @@map("task_attachments")
}

model TaskTimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startedAt DateTime @default(now())
  endedAt   DateTime?
  minutes   Int?

  @@map("task_time_entries")
}

enum DelayReason {
  CLIENTE_NAO_ENVIOU_DOCUMENTOS
  EQUIPE_INTERNA
  SISTEMA_EXTERNO
  PENDENCIA_GOVERNAMENTAL
  AGUARDANDO_APROVACAO
  OUTRO
}

model TaskDelayLog {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason       DelayReason
  detail       String?
  daysLate     Int?
  reportedById String?
  reportedBy   User?    @relation("DelayReportedBy", fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("task_delay_logs")
}

// ---------------------------------------------------------------------------
// SOLICITAÇÃO DE DOCUMENTOS AO CLIENTE
// ---------------------------------------------------------------------------

model DocumentRequest {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items DocumentRequestItem[]

  @@map("document_requests")
}

model DocumentRequestItem {
  id                String   @id @default(cuid())
  documentRequestId String
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  description       String
  received          Boolean  @default(false)
  receivedAt        DateTime?

  @@map("document_request_items")
}

// ---------------------------------------------------------------------------
// CONTRATOS
// ---------------------------------------------------------------------------

enum ContractStatus {
  RASCUNHO
  GERADO
  ENVIADO
  VISUALIZADO
  ASSINADO
  RECUSADO
  CANCELADO
}

model ContractTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  content        String   // texto do modelo com variáveis {{variavel}}
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts Contract[]

  @@map("contract_templates")
}

model Contract {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  templateId    String?
  template      ContractTemplate? @relation(fields: [templateId], references: [id])
  version       Int      @default(1)
  previousVersionId String?
  content       String   // conteúdo final gerado (HTML/markdown)
  status        ContractStatus @default(RASCUNHO)
  type          String   @default("CONTRATO") // CONTRATO, ADITIVO_VALOR, ADITIVO_SERVICO, ADITIVO_PRAZO, RESCISAO
  monthlyValue  Decimal? @db.Decimal(12, 2)
  startDate     DateTime?
  dueDay        Int?
  generatedAt   DateTime?
  sentAt        DateTime?
  viewedAt      DateTime?
  signedAt      DateTime?
  cancelledAt   DateTime?
  externalSignatureProvider String? // zapsign, clicksign, d4sign, docusign
  externalSignatureId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  services ContractService[]

  @@index([organizationId, clientId])
  @@map("contracts")
}

model ContractService {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  description String
  value      Decimal? @db.Decimal(12, 2)

  @@map("contract_services")
}

// ---------------------------------------------------------------------------
// FINANCEIRO — CONTAS A RECEBER
// ---------------------------------------------------------------------------

enum ReceivableStatus {
  A_VENCER
  VENCENDO_HOJE
  PAGO
  PARCIALMENTE_PAGO
  VENCIDO
  CANCELADO
}

model Receivable {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id])
  description    String
  competence     String?
  dueDate        DateTime
  amount         Decimal  @db.Decimal(12, 2)
  discount       Decimal? @db.Decimal(12, 2)
  interest       Decimal? @db.Decimal(12, 2)
  fine           Decimal? @db.Decimal(12, 2)
  status         ReceivableStatus @default(A_VENCER)
  recurring      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cancelledAt    DateTime?

  payments      Payment[]
  collectionLogs CollectionLog[]

  @@index([organizationId, clientId])
  @@index([organizationId, status, dueDate])
  @@map("receivables")
}

model Payment {
  id            String   @id @default(cuid())
  receivableId  String
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime @default(now())
  method        String?  // pix, boleto, cartao, transferencia, dinheiro
  createdAt     DateTime @default(now())

  @@map("payments")
}

model CollectionLog {
  id           String   @id @default(cuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  note         String
  channel      String?  // whatsapp, email, telefone
  createdAt    DateTime @default(now())

  @@map("collection_logs")
}

// ---------------------------------------------------------------------------
// DOCUMENTOS
// ---------------------------------------------------------------------------

model Document {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       String   // Fiscal, Contábil, DP, Contratos, Guias, Declarações, Certidões, Societários
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  @@index([organizationId, clientId, category])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// NOTIFICAÇÕES
// ---------------------------------------------------------------------------

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  link           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, userId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// AUTOMAÇÕES (MOTOR DE REGRAS)
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  trigger        String   // ex: TASK_DUE_SOON, TASK_OVERDUE, CONTRACT_SIGNED, RECEIVABLE_PAID, CLIENT_SERVICE_CREATED
  conditions     Json?    // condições configuráveis (regime, departamento, etc)
  actions        Json     // ações a executar (criar tarefa, notificar, mudar status)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("automation_rules")
}

// ---------------------------------------------------------------------------
// AUDITORIA
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  entityType     String   // ex: Task, Client, Contract, Receivable
  entityId       String
  action         String   // CREATE, UPDATE, DELETE, STATUS_CHANGE
  field          String?
  oldValue       String?
  newValue       String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
